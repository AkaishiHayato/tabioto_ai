# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# storageState 暗号化キー (openssl rand -hex 32 で生成)
SESSION_ENCRYPTION_KEY=your-64-char-hex-key

# LLM
GEMINI_API_KEY=your-gemini-api-key

# LINE Messaging API (公式LINE 2アカウント)
LINE_GENERAL_CHANNEL_ACCESS_TOKEN=your-general-channel-access-token
LINE_URGENT_CHANNEL_ACCESS_TOKEN=your-urgent-channel-access-token
# ホストの User ID は公式LINE 友だち追加時に Webhook で取得し DB (hosts) に保存

# Airbnb（CLI ログイン用・任意）
AIRBNB_BASE_URL=https://www.airbnb.com
AIRBNB_LOGIN_EMAIL=
AIRBNB_LOGIN_PASSWORD=
